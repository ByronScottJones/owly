{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Owly",
  "version": "0.4.1",
  "identifier": "io.github.t4t5.owly",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "./ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Owly",
        "width": 960,
        "height": 600,
        "minWidth": 640,
        "minHeight": 420,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "AirDrop for Linux"
  }
}
