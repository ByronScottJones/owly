{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "owly-gui",
  "version": "0.4.1",
  "identifier": "io.github.t4t5.owly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "./ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Owly",
        "width": 960,
        "height": 600,
        "minWidth": 640,
        "minHeight": 420,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "publisher": "The Owly authors",
    "shortDescription": "AirDrop for Linux",
    "longDescription": "The Owly AirDrop window: send and receive files and links with nearby Apple devices.",
    "linux": {
      "deb": {
        "depends": [
          "owly (>= 0.4.1)"
        ],
        "desktopTemplate": "owly-gui.desktop",
        "section": "net"
      }
    }
  }
}
